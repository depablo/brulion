<?xml version="1.0" encoding="utf-8"?>
<!-- Static sample for the widget picker; the real layout is empty until the app fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_title"
        android:textColor="@color/widget_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@color/widget_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="08:00"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/widget_preview_lesson1"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="@color/widget_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="08:55"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/widget_preview_lesson2"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="@color/widget_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="09:50"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/widget_preview_lesson3"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="@color/widget_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="10:45"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/widget_preview_lesson4"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
